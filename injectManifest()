        // =========================================
        // PWA INSTALLATION - CLEAN VERSION
        // =========================================
        
        let deferredPrompt = null;
        const installBtn = document.getElementById('install-btn');
        const updateNotification = document.getElementById('update-notification');
        const updateBtn = document.getElementById('update-btn');

        // Listen for beforeinstallprompt
        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;
            installBtn.classList.add('show');
            installBtn.textContent = '📲 Install Camalia App';
        });

        // Handle app installed event
        window.addEventListener('appinstalled', () => {
            installBtn.classList.remove('show');
            deferredPrompt = null;
            console.log('✅ Camalia app installed successfully!');
        });

        // Check if already in standalone mode
        if (window.matchMedia('(display-mode: standalone)').matches) {
            installBtn.classList.remove('show');
        }

        // iOS detection and handling
        const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
        const isInStandalone = window.navigator.standalone === true;

        if (isIOS && !isInStandalone) {
            installBtn.classList.add('show');
            installBtn.textContent = '📲 Add to Home Screen';
        }

        // Click handler for install button
        installBtn.addEventListener('click', async () => {
            if (deferredPrompt) {
                deferredPrompt.prompt();
                const { outcome } = await deferredPrompt.userChoice;
                if (outcome === 'accepted') {
                    installBtn.classList.remove('show');
                }
                deferredPrompt = null;
            } else if (isIOS) {
                const shouldShowInstructions = confirm(
                    '🌿 Add Camalia to your Home Screen:\n\n' +
                    '1. Tap the Share icon (box with arrow) at the bottom\n' +
                    '2. Scroll down and tap "Add to Home Screen"\n' +
                    '3. Tap "Add" in the top-right corner\n\n' +
                    'Would you like to see these instructions again later?'
                );
                if (!shouldShowInstructions) {
                    installBtn.classList.remove('show');
                }
            } else {
                alert('📲 To install this app, open this page in Chrome or Safari and look for the install option in your browser menu.');
            }
        });

        // =========================================
        // SERVICE WORKER REGISTRATION
        // =========================================

        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then(registration => {
                        console.log('✅ Service Worker registered successfully:', registration);
                        
                        registration.addEventListener('updatefound', () => {
                            const newWorker = registration.installing;
                            newWorker.addEventListener('statechange', () => {
                                if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                                    updateNotification.classList.add('show');
                                }
                            });
                        });
                    })
                    .catch(error => {
                        console.log('⚠️ Service Worker registration failed:', error);
                    });
            });
        }

        // Update button handler
        updateBtn.addEventListener('click', () => {
            updateNotification.classList.remove('show');
            if (navigator.serviceWorker.controller) {
                navigator.serviceWorker.controller.postMessage('skipWaiting');
            }
        });

        // Check for service worker updates
        let refreshing = false;
        navigator.serviceWorker.addEventListener('controllerchange', () => {
            if (!refreshing) {
                refreshing = true;
                window.location.reload();
            }
        });

        console.log('✅ Camalia PWA initialized successfully!');
        console.log('📱 To test PWA features:');
        console.log('   - Chrome DevTools → Application → Manifest');
        console.log('   - Chrome DevTools → Application → Service Workers');
        console.log('   - Lighthouse → Generate PWA report');
